# Normalização de fins de linha do repositório ERPell
# https://git-scm.com/docs/gitattributes

# Padrão: o Git detecta arquivos de texto e normaliza para LF no repositório,
# convertendo para o fim de linha nativo no working tree quando necessário.
* text=auto eol=lf

# ===== Scripts que exigem fim de linha específico =====
# Windows (devem usar CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix / shell (devem usar LF)
*.sh   text eol=lf
mvnw   text eol=lf

# ===== Código-fonte e configuração (texto, normalizado para LF) =====
*.java   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.properties text eol=lf
*.sql    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.json   text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.html   text eol=lf
*.md     text eol=lf

# ===== Arquivos binários (nunca normalizar) =====
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text eol=lf
*.pdf  binary
*.jar  binary
*.war  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
