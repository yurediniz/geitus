# Exemplo de variáveis de ambiente do Geitus
# ------------------------------------------------------------------
# Este arquivo serve apenas como referência. NÃO coloque dados reais
# ou segredos aqui. Copie para ".env" e preencha com valores locais:
#
#   cp .env.example .env
#
# O arquivo ".env" é ignorado pelo Git e nunca deve ser versionado.
# Para subir o backend com estas variáveis (Windows/PowerShell, na raiz):
#
#   .\scripts\dev-backend.ps1
# ------------------------------------------------------------------

# ===== Java (opcional) =====
# O backend exige JDK 21. Se o JDK padrão da máquina for outro, aponte
# aqui para um JDK 21 (usado apenas pelo scripts/dev-backend.ps1).
# JAVA_HOME=C:\caminho\para\jdk-21

# ===== Banco de dados (PostgreSQL) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=geitus_db
POSTGRES_USER=geitus
POSTGRES_PASSWORD=troque-esta-senha

# ===== Backend (Spring Boot) =====
# URL de conexão usada pela aplicação
DATABASE_URL=jdbc:postgresql://localhost:5432/geitus_db
# Porta em que a API será exposta
SERVER_PORT=8080
# Perfil ativo do Spring (ex.: dev, test, prod)
SPRING_PROFILES_ACTIVE=dev
# Segredo usado para assinar os tokens JWT (HS256).
# Precisa ter NO MÍNIMO 32 bytes (256 bits); a aplicação não sobe se for menor.
JWT_SECRET=defina-um-segredo-forte-com-no-minimo-32-bytes
# Tempo de expiração do token JWT em milissegundos (ex.: 86400000 = 24h)
JWT_EXPIRATION=86400000

# ===== Bootstrap de usuário admin de DESENVOLVIMENTO (opcional) =====
# Cria um usuário administrador local ao subir a aplicação, de forma idempotente.
# Habilite APENAS em desenvolvimento. NUNCA use estes valores em produção e nunca
# coloque uma senha real neste arquivo de exemplo.
# Ativa (true) ou não (qualquer outro valor / ausente) o bootstrap do admin dev
GEITUS_BOOTSTRAP_DEV_ADMIN=false
# E-mail do admin de desenvolvimento
GEITUS_DEV_ADMIN_EMAIL=admin@geitus.dev
# Senha do admin de desenvolvimento (troque por um valor local; nunca commitar senha real)
GEITUS_DEV_ADMIN_PASSWORD=troque-esta-senha
# Nome exibido do admin de desenvolvimento
GEITUS_DEV_ADMIN_NAME=Administrador Dev
# Nome da empresa (tenant) criada para o admin de desenvolvimento
GEITUS_DEV_COMPANY_NAME=Empresa de Desenvolvimento

# Usuário de teste do navegador (painel do app / testes manuais), perfil ADMIN,
# criado só no banco de DESENVOLVIMENTO pela API (POST /api/usuarios) na empresa do
# admin dev. São credenciais de teste: nunca existem em produção.
GEITUS_TESTE_NAVEGADOR_EMAIL=navegador@geitus.dev
GEITUS_TESTE_NAVEGADOR_SENHA=nav-yYETM8BlK7NnAYCU

# ===== Frontend (React + Vite) =====
# Não é lido daqui: o Vite lê "frontend/.env" (ver frontend/.env.example).
# Em desenvolvimento o proxy do Vite já encaminha "/api" para o backend.
