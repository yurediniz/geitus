# Exemplo de variáveis de ambiente do ERPell
# ------------------------------------------------------------------
# Este arquivo serve apenas como referência. NÃO coloque dados reais
# ou segredos aqui. Copie para ".env" e preencha com valores locais:
#
#   cp .env.example .env
#
# O arquivo ".env" é ignorado pelo Git e nunca deve ser versionado.
# As variáveis abaixo são exemplos e serão ajustadas conforme cada
# parte do projeto for implementada.
# ------------------------------------------------------------------

# ===== Banco de dados (PostgreSQL) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=erpell
POSTGRES_USER=erpell
POSTGRES_PASSWORD=troque-esta-senha

# ===== Backend (Spring Boot) =====
# URL de conexão usada pela aplicação
DATABASE_URL=jdbc:postgresql://localhost:5432/erpell
# Porta em que a API será exposta
SERVER_PORT=8080
# Perfil ativo do Spring (ex.: dev, test, prod)
SPRING_PROFILES_ACTIVE=dev
# Segredo usado para assinar os tokens JWT (HS256).
# Precisa ter NO MÍNIMO 32 bytes (256 bits); a aplicação não sobe se for menor.
JWT_SECRET=defina-um-segredo-forte-com-no-minimo-32-bytes
# Tempo de expiração do token JWT em milissegundos (ex.: 86400000 = 24h)
JWT_EXPIRATION=86400000

# ===== Bootstrap de usuário admin de DESENVOLVIMENTO (opcional) =====
# Cria um usuário administrador local ao subir a aplicação, de forma idempotente.
# Habilite APENAS em desenvolvimento. NUNCA use estes valores em produção e nunca
# coloque uma senha real neste arquivo de exemplo.
# Ativa (true) ou não (qualquer outro valor / ausente) o bootstrap do admin dev
ERPELL_BOOTSTRAP_DEV_ADMIN=false
# E-mail do admin de desenvolvimento
ERPELL_DEV_ADMIN_EMAIL=admin@erpell.dev
# Senha do admin de desenvolvimento (troque por um valor local; nunca commitar senha real)
ERPELL_DEV_ADMIN_PASSWORD=troque-esta-senha
# Nome exibido do admin de desenvolvimento
ERPELL_DEV_ADMIN_NAME=Administrador Dev
# Nome da empresa (tenant) criada para o admin de desenvolvimento
ERPELL_DEV_COMPANY_NAME=Empresa de Desenvolvimento

# ===== Frontend (React + Vite) =====
# Prefixo "VITE_" é obrigatório para variáveis expostas ao frontend
# URL base da API consumida pelo frontend
VITE_API_BASE_URL=http://localhost:8080/api
