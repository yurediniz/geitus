# Exemplo de variáveis de ambiente do ERPell
# ------------------------------------------------------------------
# Este arquivo serve apenas como referência. NÃO coloque dados reais
# ou segredos aqui. Copie para ".env" e preencha com valores locais:
#
#   cp .env.example .env
#
# O arquivo ".env" é ignorado pelo Git e nunca deve ser versionado.
# As variáveis abaixo são exemplos e serão ajustadas conforme cada
# parte do projeto for implementada.
# ------------------------------------------------------------------

# ===== Banco de dados (PostgreSQL) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=erpell
POSTGRES_USER=erpell
POSTGRES_PASSWORD=troque-esta-senha

# ===== Backend (Spring Boot) =====
# URL de conexão usada pela aplicação
DATABASE_URL=jdbc:postgresql://localhost:5432/erpell
# Porta em que a API será exposta
SERVER_PORT=8080
# Perfil ativo do Spring (ex.: dev, test, prod)
SPRING_PROFILES_ACTIVE=dev
# Segredo usado para assinar os tokens JWT (defina um valor forte e único)
JWT_SECRET=defina-um-segredo-forte
# Tempo de expiração do token JWT em milissegundos (ex.: 86400000 = 24h)
JWT_EXPIRATION=86400000

# ===== Frontend (React + Vite) =====
# Prefixo "VITE_" é obrigatório para variáveis expostas ao frontend
# URL base da API consumida pelo frontend
VITE_API_BASE_URL=http://localhost:8080/api
