# Exemplo de variaveis de ambiente do frontend (Vite).
# Copie para ".env" e ajuste conforme necessario. O ".env" e ignorado pelo Git.
#
# Em desenvolvimento nao e necessario definir nada: as chamadas para "/api"
# sao encaminhadas ao backend pelo proxy do Vite (ver vite.config.ts).

# URL base da API. Por padrao usa o caminho relativo "/api".
# Descomente e ajuste apenas se precisar apontar para outra origem.
# VITE_API_BASE_URL=/api

# Alvo do proxy de desenvolvimento (para onde "/api" e encaminhado).
# Padrao: http://localhost:8080
# VITE_DEV_API_TARGET=http://localhost:8080
